prefer-no-csd

// // // // // // // // // // //
// // // //  Inputs  // // // //
// // // // // // // // // // //

input {
    keyboard {
        xkb {
        }
        numlock
    }
    mouse {
    }
    trackpoint {
    }
    // Uncomment this to make the mouse warp to the center of newly focused windows.
    //warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}


// // // // // // // // // // //
// // // // Styling // // // //
// // // // // // // // // // //

layout {
    gaps 5
    background-color "transparent"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        width 2.2
        active-color "#d8dee9"
        inactive-color "#434c5e"
        urgent-color "#bf616a"
    }
}
overview {
    zoom 0.30
    workspace-shadow {
        off
    }
}

// // // // // // // // // //
// // // Environment // // //
// // // // // // // // // //

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
xwayland-satellite {
    // off
    path "xwayland-satellite"
}


// // // // // // // // // //
// // // ScreenShots // // //
// // // // // // // // // //

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// // // // // // // // // //
// // // // Blurs // // // //
// // // // // // // // // //

blur {
  on
  passes 4 
  noise 0.01
}

// // // // // // // // // //
// // // Layer Rules // // //
// // // // // // // // // //

layer-rule {
    match namespace="swww-daemon" // Show wallpaper in overview too!
    place-within-backdrop true
}
layer-rule { 
    match namespace="waybar"
    match at-startup=true
    opacity 0.99
    shadow {
        on
        softness 0
        spread 0
        offset x=0 y=0
    }
    geometry-corner-radius 10
}


// // // // // // // // // //
// // // Window Rule // // //
// // // // // // // // // //

window-rule {
    match app-id="^" 
    background-effect {
        blur true
        xray true
        saturation 2
    }
}
window-rule {
    open-maximized false
}
window-rule {
    match app-id=r#"brave$"# title="^Picture-in-Picture$"
    match app-id="floatingterm"
    open-floating true
}
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}
window-rule {
    match app-id=r#"^Pinentry-gtk$"#
    match app-id="Tk"
    match app-id=r#"^Tk$"#
    match app-id=r#"^gimp$"# title=r#"Preferences"#
    match app-id=r#"^mpv$"#
    match app-id=r#"^soffice$"# title=r#"^Text Import"#
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    match app-id=r#"^wev$"#
    match app-id=r#"^xarchiver$"#
    open-floating true
}
window-rule {
    match app-id=r#"^dot\.floating\.ghostty$"#
    match app-id=r#"^dot\.floating\.thunar$"#
    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}

window-rule {
    draw-border-with-background false
    match app-id="^" // For all apps
    match app-id="code"
    match app-id="kitty"
    match app-id="vesktop"
    match app-id="org.qbittorrent.qBittorrent"
    match app-id="thunar"
    match app-id="org.gnome.Nautilus"
    match app-id="chromium"
    match app-id="zathura"
    match app-id="engrampa"
    match app-id="abaddon"
    match app-id="obsidian"
    match app-id="zen"
    match app-id="tsuzuku"
    match app-id="obs-studio"
    match app-id="Spotify"
    match app-id="rofi"
    opacity 0.90
}
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}


// // // // // // // // // // //
// // // // Startups // // // //
// // // // // // // // // // //

hotkey-overlay {
    skip-at-startup
}
spawn-sh-at-startup     "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup     "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup     "wl-clip-persist --clipboard regular"
spawn-sh-at-startup     "wl-clip-persist --clipboard primary"
spawn-sh-at-startup     "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &"
spawn-at-startup        "wlsunset"
spawn-at-startup        "swww-daemon"
spawn-at-startup        "waybar"
spawn-at-startup        "swaync"
spawn-at-startup        "playerctld"
spawn-at-startup        "swayosd-server"
spawn-at-startup        "activate-linux"


// Do not remove it.
include "./colors/niri-colors.kdl"
include "./modules/keybinds.kdl"
